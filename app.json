{
  "expo": {
    "name": "Ma Bible",
    "slug": "ma-bible",
    "scheme": "mabible",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mabible.app"
    },
    "android": {
      "package": "com.mabible.app"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "1fbb115d-6c87-4a0b-8b96-e0400b4273a6"
      }
    }
  }
}
